{
  "name": "ai-council",
  "displayName": "AI Council - Multi-Model Code Review",
  "description": "Get parallel code reviews from GPT-4, Grok, Claude, Gemini, and self-hosted Ollama - via API keys or your existing CLI subscriptions - with scoped review, debate, and consolidation.",
  "version": "0.1.0",
  "publisher": "laurence73",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "code review",
    "ai",
    "gpt-4",
    "claude",
    "grok",
    "gemini",
    "multi-model",
    "security"
  ],
  "activationEvents": [
    "onView:ai-council.sidebar"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/laurence73/ai-council"
  },
  "contributes": {
    "commands": [
      {
        "command": "ai-council.reviewFile",
        "title": "AI Council: Review Current File",
        "icon": "$(eye)"
      },
      {
        "command": "ai-council.reviewFilePower",
        "title": "AI Council: Review Current File (Power Mode)",
        "icon": "$(zap)"
      },
      {
        "command": "ai-council.reviewCommit",
        "title": "AI Council: Review Current Commit",
        "icon": "$(git-commit)"
      },
      {
        "command": "ai-council.reviewWithScope",
        "title": "AI Council: Review with Scope",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "ai-council.showLastReview",
        "title": "AI Council: Show Last Review"
      },
      {
        "command": "ai-council.clearCache",
        "title": "AI Council: Clear Review Cache"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ai-council.reviewFile",
          "group": "navigation",
          "when": "editorLangId =~ /csharp|razor|javascript|javascriptreact|typescript|typescriptreact|python|java|go|rust|cpp|c/"
        }
      ],
      "editor/context": [
        {
          "command": "ai-council.reviewFile",
          "group": "ai-council@1",
          "when": "editorTextFocus"
        },
        {
          "command": "ai-council.reviewFilePower",
          "group": "ai-council@2",
          "when": "editorTextFocus"
        },
        {
          "command": "ai-council.reviewWithScope",
          "group": "ai-council@3",
          "when": "editorTextFocus"
        }
      ],
      "explorer/context": [
        {
          "command": "ai-council.reviewFile",
          "group": "ai-council@1",
          "when": "resourceExtname =~ /\\.(cs|razor|js|ts|py|java|go|rs|cpp|c|jsx|tsx)$/"
        }
      ]
    },
    "configuration": {
      "title": "AI Council",
      "properties": {
        "ai-council.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to Python executable"
        },
        "ai-council.scriptPath": {
          "type": "string",
          "default": "",
          "description": "Path to ai_council.py script. Leave empty to use bundled script."
        },
        "ai-council.apiKeys.openai": {
          "type": "string",
          "default": "",
          "description": "OpenAI API Key (for GPT-4). Get yours at: https://platform.openai.com/api-keys"
        },
        "ai-council.apiKeys.anthropic": {
          "type": "string",
          "default": "",
          "description": "Anthropic API Key (for Claude). Get yours at: https://console.anthropic.com/"
        },
        "ai-council.apiKeys.xai": {
          "type": "string",
          "default": "",
          "description": "xAI API Key (for Grok). Get yours at: https://console.x.ai/"
        },
        "ai-council.apiKeys.google": {
          "type": "string",
          "default": "",
          "description": "Google API Key (for Gemini - FREE!). Get yours at: https://aistudio.google.com/app/apikey"
        },
        "ai-council.apiKeys.ollama": {
          "type": "string",
          "default": "",
          "description": "WoW AI auth (user:pass for Basic auth, or Bearer token)"
        },
        "ai-council.ollamaUrl": {
          "type": "string",
          "default": "",
          "description": "WoW AI / Ollama server URL"
        },
        "ai-council.ollamaModel": {
          "type": "string",
          "default": "qwen3.6:35b-mlx",
          "description": "Ollama model to use for code review",
          "enum": [
            "qwen3.6:35b-mlx",
            "qwen3-coder-next:latest",
            "qwen3-coder-next:q4_K_M",
            "qwen2.5-coder:14b",
            "gemma4:12b-mlx",
            "llama3.2:latest"
          ]
        },
        "ai-council.autoReviewOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Run a full review immediately whenever a supported source file is saved. Requires the AI Council sidebar (or any AI Council command) to have run at least once this window session - saves before that won't trigger a review, since the extension only activates on first use, not at VS Code startup."
        },
        "ai-council.reviewRubric": {
          "type": "string",
          "editPresentation": "multilineText",
          "default": "",
          "description": "What the council should look for during a review (layer 2). Leave blank for the built-in default (bugs, security, performance, code quality, architecture). This does NOT replace the permanent integrity rule (layer 1: no manufactured findings, no rubber-stamped consensus) - that always applies and cannot be edited here."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-council",
          "title": "AI Council",
          "icon": "media/ai-council-icon.svg"
        }
      ]
    },
    "views": {
      "ai-council": [
        {
          "type": "webview",
          "id": "ai-council.sidebar",
          "name": "AI Council"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  }
}
